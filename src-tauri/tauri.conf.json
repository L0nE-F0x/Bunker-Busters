{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bunker Busters",
  "version": "1.1.3",
  "identifier": "dev.bunkerbusters.game",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist-desktop",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/desktop-dist.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bunker Busters",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "preventOverflow": true,
        "resizable": true,
        "url": "play/index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "category": "ActionGame",
    "shortDescription": "First-person heist game: break into the tech elite's doomsday bunkers",
    "longDescription": "They built bunkers. You brought lockpicks. Bunker Busters is a free first-person heist game set in a desert wasteland: scout the founders' doomsday bunkers, get past their half-broken security and Kade's contractors, and bring the water back to camp. Eight bunkers, a fully voiced story, lockpicking, circuit, keypad and hacking minigames, wolves, dust storms and a day-night cycle.",
    "homepage": "https://bunker-busters.netlify.app/",
    "copyright": "Copyright © 2026 L0nE-F0x",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/licenses.txt": "licenses.txt"
    },
    "linux": {
      "deb": {
        "section": "games",
        "desktopTemplate": "linux/bunker-busters.desktop",
        "files": {
          "/usr/share/metainfo/dev.bunkerbusters.game.metainfo.xml": "linux/dev.bunkerbusters.game.metainfo.xml"
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNjI2NjA2RTVFRjA0NEMKUldSTUJPL2xCbVppcmd6MVlGbjZUUmcwZHQyWGVaNEp0bEZYYjR2U2N5dDNtTkwrSHVxeEVFenkK",
      "endpoints": [
        "https://github.com/L0nE-F0x/Bunker-Busters/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
