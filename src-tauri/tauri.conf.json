{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bunker Busters",
  "version": "0.1.0",
  "identifier": "dev.bunkerbusters.game",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bunker Busters",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Game",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
