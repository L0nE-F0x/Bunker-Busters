{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bunker Busters",
  "version": "0.1.7",
  "identifier": "dev.bunkerbusters.game",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bunker Busters",
        "width": 1600,
        "height": 900,
        "minWidth": 960,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "url": "play/index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNjI2NjA2RTVFRjA0NEMKUldSTUJPL2xCbVppcmd6MVlGbjZUUmcwZHQyWGVaNEp0bEZYYjR2U2N5dDNtTkwrSHVxeEVFenkK",
      "endpoints": [
        "https://github.com/L0nE-F0x/Bunker-Busters/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
