# Website settings: owner decisions, kept in one place. Nothing secret goes in this file (it's public).
# Vite puts each value into the site's HTML at build time (%VITE_NAME% in index.html, press/, privacy/)
# and into src/site/*.ts (import.meta.env.VITE_NAME). Change a line, then push: the site rebuilds.

# Who made the game, as the press kit and the search-engine data (JSON-LD) name you.
VITE_DEVELOPER=Lone Fox
VITE_DEVELOPER_URL=https://github.com/L0nE-F0x

# TODO(owner): a press contact email. Empty = no address anywhere on the site; the press kit sends
# people to GitHub Issues instead.
VITE_PRESS_EMAIL=

# The launch trailer on YouTube (a watch, youtu.be or embed link). Empty = the press kit shows the
# gameplay loop instead. The video only loads from YouTube when a visitor presses play.
VITE_TRAILER_YOUTUBE=
